{
  "name": "kingdom-rush-dove-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "node tools/run-ui-tests.mjs",
    "check:data": "node tools/check-snapshot.mjs",
    "sync:dove": "node tools/sync-dove.mjs",
    "changelog:dove": "node tools/game-changelog.mjs --previous-ref HEAD",
    "assets:restore": "node tools/assets.mjs restore",
    "assets:pack": "node tools/assets.mjs pack",
    "assets:publish": "node tools/assets.mjs publish",
    "ratings:sync": "node tools/import-ratings.mjs",
    "publish:update": "node tools/publish-update.mjs",
    "predev": "npm run assets:restore",
    "prebuild": "npm run assets:restore",
    "pretest": "npm run assets:restore",
    "precheck:data": "npm run assets:restore"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
